/* Overall customer churn */
SELECT
    COUNT(*) AS total_subscriptions,
    SUM(CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END) AS cancelled_subscriptions,
    CAST(
        100.0 * SUM(CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END) / COUNT(*)
        AS DECIMAL(5,2)
    ) AS historical_cancellation_rate
FROM subscriptions;

/* Monthly cancellation activity*/
SELECT
    YEAR(ended_at) AS churn_year,
    MONTH(ended_at) AS churn_month,
    COUNT(*) AS cancellations
FROM subscriptions
WHERE status = 'cancelled'
GROUP BY YEAR(ended_at), MONTH(ended_at)
ORDER BY churn_year, churn_month;

/* Churn by plan				*/
SELECT
    p.plan_name,
    COUNT(*) AS total_subscriptions,
    SUM(CASE WHEN s.status = 'cancelled' THEN 1 ELSE 0 END) AS cancelled,
    CAST(100.0 * SUM(CASE WHEN s.status = 'cancelled' THEN 1 ELSE 0 END) / COUNT(*) AS DECIMAL(5,2)) AS cancellation_rate,
    SUM(CASE WHEN s.status = 'cancelled' THEN s.mrr ELSE 0 END) AS cancelled_mrr
FROM subscriptions s
JOIN plans p ON s.plan_id = p.plan_id
GROUP BY p.plan_name
ORDER BY cancellation_rate DESC;

/* Churn by segment				*/
SELECT
    a.segment,
    COUNT(*) AS total_subscriptions,
    SUM(CASE WHEN s.status = 'cancelled' THEN 1 ELSE 0 END) AS cancelled,
    CAST(100.0 * SUM(CASE WHEN s.status = 'cancelled' THEN 1 ELSE 0 END) / COUNT(*) AS DECIMAL(5,2)) AS cancellation_rate,
    SUM(CASE WHEN s.status = 'cancelled' THEN s.mrr ELSE 0 END) AS cancelled_mrr
FROM subscriptions s
JOIN accounts a ON s.account_id = a.account_id
GROUP BY a.segment
ORDER BY cancellation_rate DESC;

